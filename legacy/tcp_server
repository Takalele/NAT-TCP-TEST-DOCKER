#!/usr/bin/env python3

import argparse
import logging
import socket
import socketserver
import struct


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True
    request_queue_size = socket.SOMAXCONN


class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        logging.info("Connected by %s:%d", *self.client_address)
        try:
            if self.server.mode == "reset":
                # Abort the established connection using the kernel's TCP state.
                self.request.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
                self.request.close()
                return
            while data := self.request.recv(4096):
                if self.server.mode == "normal":
                    self.request.sendall(data)
        except OSError as error:
            logging.info("Connection %s:%d ended: %s", *self.client_address, error)


def main():
    parser = argparse.ArgumentParser(description="TCP server for testing NAT behavior")
    parser.add_argument("-p", "--port", type=int, default=12345, help="TCP port to bind (default: %(default)s)")
    parser.add_argument("-b", "--bind", default="0.0.0.0", help="IPv4 address to bind (default: %(default)s)")
    parser.add_argument("--mode", choices=("reset", "normal", "silent"), default="reset", help="Reset on accept, echo until EOF, or read silently until EOF (default: %(default)s)")
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error("port must be between 0 and 65535")

    logging.basicConfig(level=logging.INFO, format="[Server] %(message)s")
    try:
        with Server((args.bind, args.port), Handler) as server:
            server.mode = args.mode
            logging.info("Listening on %s:%d (%s)", *server.server_address, args.mode)
            server.serve_forever()
    except KeyboardInterrupt:
        logging.info("Shutting down")
    except OSError as error:
        logging.error("%s", error)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
