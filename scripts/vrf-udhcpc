#!/bin/bash
set -e

case ${1:-} in
    bound|renew|deconfig) ;;
    *) exit 0 ;;
esac

[[ ${interface:-} =~ ^eth([1-9][0-9]{0,7})$ ]] || exit 1
table=$(( BASH_REMATCH[1] + 10 ))
(( table < 253 || table > 255 )) || exit 1
vrf="vrf_$interface"
# Never change a lease after its link has been removed or left our VRF.
link=$(ip -o link show dev "$interface" 2>/dev/null) || exit 0
[[ $link == *" master $vrf "* ]] || exit 0
master=$(ip -d -o link show dev "$vrf")
[[ $master == *" vrf table $table "* ]] || exit 1

state="/run/vrf-udhcpc/$interface"
previous=
if [[ -f $state ]]; then
    read -r previous < "$state"
fi

lease=
if [[ $1 != deconfig ]]; then
    [[ ${ip:-} =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && ${mask:-32} =~ ^([0-9]|[12][0-9]|3[0-2])$ ]] || exit 1
    lease="$ip/${mask:-32}"
fi

# Delete only the address recorded by this hook and DHCP routes on this link.
if [[ -n $previous && $previous != "$lease" ]]; then
    ip -4 addr del "$previous" dev "$interface" 2>/dev/null || :
fi
ip -4 route flush table "$table" dev "$interface" proto dhcp
if [[ -z $lease ]]; then
    rm -f -- "$state"
    exit 0
fi

ip -4 addr replace "$lease" broadcast + dev "$interface"
mkdir -p -- "${state%/*}"
printf '%s\n' "$lease" > "$state"

read -r -a gateways <<< "${router:-}"
metric=100
for gateway in "${gateways[@]}"; do
    [[ $gateway != 0.0.0.0 && $gateway =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || continue
    ip -4 route replace default via "$gateway" dev "$interface" onlink table "$table" proto dhcp metric "$metric"
    metric=$(( metric + 1 ))
done
